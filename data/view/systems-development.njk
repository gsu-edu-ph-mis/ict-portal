{% extends "document.html" %}

{% block body %}
    <div class="row">
        <div class="col-md-12 pb-5">
            <header class="text-center">
                <img class="mb-4" width="250" height="250" src="/images/logo-ictu.png" alt="ICT Logo">
                <h1 class="h4">Systems <span class="text-danger">Development</span> </h1>
            </header>
        </div>
    </div>
    
    <div class="row align-items-center mb-5">
        <div class="col-md-5 text-center">
            <a class="d-block border" href="/images/system-hris.jpg" target="_blank"><img src="/images/system-hris.jpg" alt="system-hris"></a>
        </div>
        <div class="col-md-7 pt-3 text-md-left">
            <h3 class="h3 mb-1">Human Resource Information System (HRIS)</h3>
            <h4 class="h5 mb-3">Programmer: <span class="text-danger">Nico Amarilla, Cris Vincent Ferrer</span></h4>
            <p class="text-justify"><strong>Description:</strong> A centralized digital platform that automates human resource operations by managing employee records, attendance, and HR transactions, with reliable offline-to-online synchronization to ensure continuity during power and network interruptions.</p>
            <p class="text-justify"><strong>Function:</strong> The HRIS manages employee information, monitors attendance through biometric and online logs, facilitates electronic HR services such as leave and travel applications, and ensures uninterrupted data capture through resilient syncing mechanisms that operate even during power and connectivity outages.</p>
        </div>
        
    </div>
    <div class="row align-items-center mb-5">
        <div class="col-md-5 text-center">
            <a class="d-block border" href="/images/system-scheduling.jpg" target="_blank"><img src="/images/system-scheduling.jpg" alt="system-scheduling"></a>
        </div>
        <div class="col-md-7 pt-3 text-md-left">
            <h3 class="h3">Class &amp; Exam Schedule Portal</h3>
            <h4 class="h5 mb-3">Programmer: <span class="text-danger"> John Michael Gadot</span></h4>
            <p class="text-justify"><strong>Description:</strong> A centralized web-based system that publishes and manages class and examination schedules, faculty teaching loads, and room assignments to ensure transparency, coordination, and efficient academic planning.</p>
            <p class="text-justify"><strong>Function:</strong> The portal organizes and displays class schedules, examination timetables, faculty teaching schedules, and room allocations, providing students, faculty, and administrators with accurate and up-to-date scheduling information per semester.</p>
        </div>
    </div>
    <div class="row align-items-center mb-5">
        <div class="col-md-5 text-center">
            {# <a class="d-block border m-1" href="/images/system-clinico1.jpg" target="_blank"><img src="/images/system-clinico1.jpg" alt="system-clinico1"></a> #}
            <a class="d-block border m-1" href="/images/system-clinico.jpg" target="_blank"><img src="/images/system-clinico.jpg" alt="system-clinico"></a>
        </div>
        <div class="col-md-7 pt-3 text-md-left text-center">
            <h3 class="h3">Clinic Online Portal</h3>
            <h4 class="h5 mb-3">Programmer: <span class="text-danger"> Nico Amarilla</span></h4>
            <p class="text-justify"><strong>Description:</strong> A secure web-based system that digitizes student health records by providing an electronic Medical Record Card (MRC) accessible to authorized clinic staff and students.</p>
            <p class="text-justify"><strong>Function:</strong> The students and clinic staff can securely view and update medical information, significantly reducing manual searching of paper-based records and improving service delivery during enrolment and clearance seasons.</p>
        </div>
    </div>
    <div class="row align-items-center mb-5">
        <div class="col-md-5 text-center">
            <a class="d-block border m-1" href="/images/system-boardroom1.jpg" target="_blank"><img src="/images/system-boardroom1.jpg" alt="system-boardroom1"></a>
            <a class="d-block border m-1" href="/images/system-boardroom.jpg" target="_blank"><img src="/images/system-boardroom.jpg" alt="system-boardroom"></a>
        </div>
        <div class="col-md-7 pt-3 text-md-left">
            <h3 class="h3">The Board Room</h3>
            <h4 class="h5 mb-3">Programmer: <span class="text-danger"> Nico Amarilla</span></h4>
            <p class="text-justify"><strong>Description:</strong> A secure online platform for creating, managing, and presenting Board of Regents meeting agendas, enabling controlled digital access to agenda documents and supporting paperless governance processes.</p>
            <p class="text-justify"><strong>Function:</strong> The system allows authorized users to create and organize meeting agendas through a graphical interface (non-techie people), securely distribute agenda access to Board members via expiring links, and present agenda items with embedded PDF viewing to ensure confidentiality and efficient meeting proceedings.</p>
        </div>
    </div>
    <div class="row align-items-center mb-5">
        <div class="col-md-5 text-center">
            <a class="d-block border border-2 m-1" href="/images/system-alumni.jpg" target="_blank"><img src="/images/system-alumni.jpg" alt="system-alumni"></a>
        </div>
        <div class="col-md-7 pt-3 text-md-left">
            <h3 class="h3">Alumni Portal</h3>
            <h4 class="h5 mb-3">Programmer: <span class="text-danger"> John Michael Gadot</span></h4>
            <p class="text-justify"><strong>Description:</strong> An online platform that maintains alumni records and supports engagement between the university and its graduates through centralized information management.</p>
            <p class="text-justify"><strong>Function:</strong> The portal enables the university to collect, manage, and update alumni information, providing a digital channel for maintaining graduate records and strengthening institutional connections with alumni.</p>
        </div>
    </div>
    <div class="row align-items-center mb-5">
        <div class="col-md-5 text-center">
            <a class="d-block border m-1" href="/images/system-gsuweb.jpg" target="_blank"><img src="/images/system-gsuweb.jpg" alt="system-boardrgsuweboom1"></a>
        </div>
        <div class="col-md-7 pt-3 text-md-left text-center">
            <h3 class="h3">Guimaras State University Website</h3>
            <h4 class="h5 mb-3">Programmer: <span class="text-danger"> Nico Amarilla</span></h4>
            <p class="text-justify"><strong>Description:</strong> The official online presence of Guimaras State University, serving as the primary platform for publishing institutional information, announcements, and public-facing services.</p>
            <p class="text-justify"><strong>Function:</strong> The website disseminates accurate and up-to-date information about the university, including academic programs, offices, news, and advisories, while providing accessible links to online systems and digital services for students, personnel, and the general public.</p>
        </div>
    </div>
    <div class="row align-items-center mb-5">
        <div class="col-md-5 text-center">
            <a class="d-block border m-1" href="/images/system-journal.jpg" target="_blank"><img src="/images/system-journal.jpg" alt="system-journal"></a>
        </div>
        <div class="col-md-7 pt-3 text-md-left text-center">
            <h3 class="h3">Center for Journal Publications</h3>
            <h4 class="h5 mb-3">Programmer: <span class="text-danger"> Nico Amarilla</span></h4>
            <p class="text-justify"><strong>Description:</strong> The official journal publication platform of the university, built on a customized Open Journal Systems (OJS), supporting the end-to-end management and online dissemination of scholarly journals.</p>
            <p class="text-justify"><strong>Function:</strong> The website manages the full academic publishing workflow, including journal submission, peer review, editorial processing, and online publication, while providing open and controlled access to published research in accordance with scholarly publishing standards.</p>
        </div>
    </div>
    <div class="row align-items-center mb-5">
        <div class="col-md-5 text-center">
            <a class="d-block border border-2 m-1" href="/images/system-cst.jpg" target="_blank"><img src="/images/system-cst.jpg" alt="system-cst"></a>
        </div>
        <div class="col-md-7 pt-3 text-md-left text-center">
            <h3 class="h3">College of Science and Technology Website</h3>
            <h4 class="h5 mb-3">Programmer: <span class="text-danger"> Nico Amarilla</span></h4>
            <p class="text-justify"><strong>Description:</strong> The official website of the College of Science and Technology, providing academic information, announcements, and public-facing content specific to the college.</p>
            <p class="text-justify"><strong>Function:</strong> The website publishes up-to-date information on academic programs, faculty, research initiatives, student activities, and college advisories, serving as the primary digital information portal for stakeholders of the College of Science and Technology.</p>
        </div>
    </div>
    
    <div class="row align-items-center mb-5">
        <div class="col-md-5 text-center">
            <a class="d-block border border-2 m-1" href="/images/system-bacis.jpg" target="_blank"><img src="/images/system-bacis.jpg" alt="system-bacis"></a>
        </div>
        <div class="col-md-7 pt-3 text-md-left text-center">
            <h3 class="h3">BAC-IS</h3>
            <h4 class="h5 mb-3">Programmer: <span class="text-danger"> Nico Amarilla</span></h4>
            <p class="text-justify"><strong>Description:</strong> A dedicated online system for managing and publishing Bids and Awards Committee announcements to the university website through automated system integration.</p>
            <p class="text-justify"><strong>Function:</strong> The system facilitates the electronic creation and management of BAC postings and publishes approved procurement notices to the official website using REST API, ensuring timely disclosure, accuracy of information, and compliance with government procurement transparency requirements.</p>
        </div>
    </div>
    <div class="row align-items-center mb-5">
        <div class="col-md-5 text-center">
            <a class="d-block border m-1" href="/images/system-ictportal.jpg" target="_blank"><img src="/images/system-ictportal.jpg" alt="system-ictportal"></a>
        </div>
        <div class="col-md-7 pt-3 text-md-left text-center">
            <h3 class="h3">ICT Portal</h3>
            <h4 class="h5 mb-3">Programmer: <span class="text-danger"> Nico Amarilla</span></h4>
            <p class="text-justify"><strong>Description:</strong> A centralized online platform for managing university ICT service requests and digital account provisioning.</p>
            <p class="text-justify"><strong>Function:</strong> The portal enables users to request official GSU accounts, apply for university ID cards, and generate passphrases or passwords, providing a standardized and secure entry point to the university’s digital services.</p>
        </div>
    </div>
    <div class="row align-items-center mb-5">
        <div class="col-md-5 text-center">
            <a class="d-block border border-2 m-1" href="/images/system-servicedesk.jpg" target="_blank"><img src="/images/system-servicedesk.jpg" alt="system-servicedesk"></a>
        </div>
        <div class="col-md-7 pt-3 text-md-left text-center">
            <h3 class="h3">ICTU Service Desk</h3>
            <h4 class="h5 mb-3">Programmer: <span class="text-danger"> John Michael Gadot</span></h4>
            <p class="text-justify"><strong>Description:</strong> A centralized online system for managing ICTU service requests, asset-related records, and operational logs for students and university personnel.</p>
            <p class="text-justify"><strong>Function:</strong> The system manages student and employee information for ID card printing, records repair and maintenance requests, and documents pre- and post-inspection reports, enabling systematic tracking of services, accountability, and efficient service delivery.</p>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 pb-5">
            <header class="text-center">
                <h1 class="h4">Pipelined <span class="text-danger">Projects</span> (Under Development)</h1>
            </header>
        </div>
    </div>
    <div class="row align-items-center mb-5">
        <div class="col-md-5 text-center">
            <a class="d-block border" href="/images/system-sems.jpg" target="_blank"><img src="/images/system-sems.jpg" alt="system-sems"></a>
        </div>
        <div class="col-md-7 pt-3 text-md-left text-center">
            <h3 class="h3 mb-1">Supply and Equipment Management System (SEMS)</h3>
            <h4 class="h5 mb-3">Programmer: <span class="text-danger"> Nico Amarilla, Cris Vincent Ferrer, John Michael Gadot</span></h4>
            <p class="text-justify"><strong>Description:</strong> An integrated system for managing the lifecycle of university supplies and equipment, from procurement receipt to storage, issuance, and disposal.</p>
            <p class="text-justify"><strong>Function:</strong> The system records and tracks inbound deliveries, inspection and acceptance, inventory storage, and issuance of supplies and equipment, including the generation of required property and stock records such as Property Cards, Stock Cards, PAR, and ICS, to support accurate inventory control and audit compliance.</p>
        </div>
    </div>
    <div class="row align-items-center mb-5">
        <div class="col-md-5 text-center">
            {# <a class="d-block border border-2 m-1" href="/images/system-servicedesk.jpg" target="_blank"><img src="/images/system-servicedesk.jpg" alt="system-servicedesk"></a> #}
        </div>
        <div class="col-md-7 pt-3 text-md-left">
            <h3 class="h3">Records Management</h3>
            <h4 class="h5 mb-3">Programmer: <span class="text-danger"> Cris Vincent Ferrer</span></h4>
            <p class="text-justify"><strong>Description:</strong> A centralized digital system for the systematic organization, storage, retrieval, and preservation of official university records.</p>
            <p class="text-justify"><strong>Function:</strong> The system manages electronic records throughout their lifecycle, including classification, indexing, secure storage, controlled access, and retrieval, in support of records retention, audit readiness, and compliance with records management and archival standards.</p>
        </div>
    </div>
    <div class="row align-items-center mb-5">
        <div class="col-md-5 text-center">
            {# <a class="d-block border border-2 m-1" href="/images/system-servicedesk.jpg" target="_blank"><img src="/images/system-servicedesk.jpg" alt="system-servicedesk"></a> #}
        </div>
        <div class="col-md-7 pt-3 text-md-left">
            <h3 class="h3">Student Unified Management App (SUMA)</h3>
            <h4 class="h5 mb-3">Programmer: <span class="text-danger"> Nico Amarilla</span></h4>
            <p class="text-justify"><strong>Description:</strong> A centralized digital platform that integrates and manages student records, enrollment, academic information, and related student services in a single, user-friendly application.</p>
            <p class="text-justify"><strong>Function:</strong> The system consolidates student data and academic processes, including enrollment management, academic performance tracking, class and examination schedules, and access to student services, providing a unified and efficient platform for students, faculty, and administrators.</p>
        </div>
    </div>
    <div class="row align-items-center mb-5">
        <div class="col-md-12 text-center pt-5 pb-5 mt-5">We are the ICT<span class="text-danger">U</span>. Ready to serve <span class="text-danger">U</span>.</div>
    </div>
    
{% endblock %}
{% block scripts %}
{{ super() }}
<script>
    /**
     * 
    "We are the ICTU. Ready to help you."
    "We are the ICTU. Solutions through and through."
    "We are the ICTU. Innovation is our cue."
    "We are the ICTU. Your tech dreams come true."
    "We are the ICTU. Support that's tried and true." 
     */
    jQuery(".fx-noticemesenpai").click(function() {
        document.querySelector('#target1').scrollIntoView({
            behavior: 'smooth'
        });
        jQuery(".fx-noticemesenpai").removeClass('fx-noticemesenpai')
    });
</script>
{% endblock %}
</body>
</html>
